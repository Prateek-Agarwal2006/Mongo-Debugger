    "low": 50,
    "high": 90
  },
  "repl_lag_": {
    "label": "repl_lag_\u0026lt;host\u0026gt; (s)",
    "formula": "p95 of replication lag",
    "low": 5,
    "high": 30
  },
  "scan_keys": {
    "label": "scan_keys",
    "formula": "scan_keys",
    "low": 0,
    "high": 1048576
  },
  "scan_objects": {
    "label": "scan_objects",
    "formula": "avg of [](scan_objects/scan_keys)",
    "low": 2,
    "high": 5
  },
  "scan_sort": {
    "label": "scan_sort",
