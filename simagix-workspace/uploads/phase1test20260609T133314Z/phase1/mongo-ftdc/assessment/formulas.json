{
  "conns_created/s": {
    "label": "conns_created/s",
    "formula": "conns_created/s",
    "low": 0,
    "high": 5
  },
  "conns_current": {
    "label": "conns_current %%",
    "formula": "1MB*(p95 of conns_current)/RAM",
    "low": 5,
    "high": 20
  },
  "cpu_idle": {
    "label": "cpu_idle %%",
    "formula": "p5 of cpu_idle",
    "low": 50,
    "high": 80
  },
  "cpu_iowait": {
    "label": "cpu_iowait %%",
    "formula": "p95 of cpu_iowait",
    "low": 5,
    "high": 15
  },
  "cpu_system": {
    "label": "cpu_system %%",
    "formula": "p95 of cpu_system",
    "low": 5,
    "high": 15
  },
  "cpu_user": {
    "label": "cpu_user %%",
