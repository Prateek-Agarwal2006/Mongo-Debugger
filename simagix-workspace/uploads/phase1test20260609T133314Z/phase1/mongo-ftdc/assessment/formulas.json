    "low": 5,
    "high": 20
  },
  "write_conflicts/s": {
    "label": "write_conflicts/s",
    "formula": "p95 of write_conflicts/s",
    "low": 10,
    "high": 100
  },
  "wt_cache_dirty": {
    "label": "wt_cache_dirty %%",
    "formula": "(p95 of wt_cache_dirty)/wt_cache_max",
    "low": 5,
    "high": 20
  },
  "wt_cache_used": {
    "label": "wt_cache_used %%",
