  },
  "query_targeting_keys": {
    "label": "query_targeting_keys",
    "formula": "p95 of (keys_examined/docs_returned)",
    "low": 10,
    "high": 100
  },
  "query_targeting_objects": {
    "label": "query_targeting_objects",
    "formula": "p95 of (docs_examined/docs_returned)",
    "low": 10,
    "high": 100
  },
  "queued_read": {
    "label": "queued_read",
