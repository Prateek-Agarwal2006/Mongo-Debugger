# ── API (FastAPI) ─────────────────────────────────────────────────────────────
# There was a go-builder stage here compiling ftdc-slice from
# simagix-workspace/repos/mongo-ftdc. That path is gitignored, so it is absent
# from every clean checkout and the stage could never build in CI. The upstream
# repo it points at has no cmd/ftdc-slice either.
#
# The API does not need the binary to run: simagix/evidence/ftdc_tools.py
# resolves it via shutil.which() and degrades to an error result when missing,
# so only the tier-3 get_raw_window MCP path is affected. Restore the stage if
# the mongo-ftdc fork that actually contains cmd/ftdc-slice is located.
FROM python:3.11-slim

WORKDIR /app

# Install system deps (needed for psycopg binary wheel)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Deps layer: only invalidated when pyproject.toml changes.
# Stub package satisfies setuptools; real code is COPY'd below + reinstalled --no-deps.
# (BuildKit pip cache mounts need docker-buildx — not assumed on Colima/legacy builder.)
COPY pyproject.toml .
RUN mkdir -p backend && printf '"""pip-layer stub — replaced by COPY backend/"""\n' > backend/__init__.py
RUN pip install --no-cache-dir ".[prod,llm]"

# App code only — UI is a separate nginx image (no Jinja/static on API).
COPY backend/ backend/
RUN pip install --no-cache-dir --no-deps .

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.app.main:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
