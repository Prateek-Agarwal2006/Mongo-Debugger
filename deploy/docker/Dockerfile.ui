# ── Stage 1: Vite Modern SPA ────────────────────────────────────────────────
FROM node:20-alpine AS build
RUN apk upgrade --no-cache
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ── Stage 2: nginx serves SPA + static stitch; proxies API ──────────────────
# alpine-slim, not alpine: the full image bundles the XSLT module and with it
# libxml2, which trips the Lacework HIGH gate (CVE-2025-32414/32415) and is
# useless to an SPA host. slim keeps envsubst + /docker-entrypoint.d, so the
# default.conf.template below still renders.
FROM nginx:1.29-alpine-slim
RUN apk upgrade --no-cache

COPY deploy/docker/nginx-ui.conf /etc/nginx/templates/default.conf.template
ENV API_UPSTREAM=api:8000

COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/static /usr/share/nginx/html/static
RUN chmod -R a+rX /usr/share/nginx/html

EXPOSE 8080
