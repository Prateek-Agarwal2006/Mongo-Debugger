# ── Stage 1: build Go binaries ──────────────────────────────────────────────
FROM golang:1.25-alpine AS go-builder

RUN apk add --no-cache git bash

WORKDIR /build

# Download deps first — this layer is cached as long as go.mod/go.sum don't change.
# Rebuilds after source edits skip this step entirely.
COPY simagix-workspace/repos/mongo-ftdc/go.mod simagix-workspace/repos/mongo-ftdc/go.sum ./
RUN go mod download

# Now copy source and compile
COPY simagix-workspace/repos/mongo-ftdc/ .
RUN CGO_ENABLED=0 go build -o /out/llm-export  ./cmd/llm-export && \
    CGO_ENABLED=0 go build -o /out/ftdc-slice  ./cmd/ftdc-slice

# ── Stage 2: Python worker with Go binaries ──────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Worker is Phase 1 only — `.[prod]` (no Cursor/ADK).
# Deps layer cached until pyproject.toml changes; code-only rebuilds skip heavy pip.
COPY pyproject.toml .
RUN mkdir -p backend && printf '"""pip-layer stub — replaced by COPY backend/"""\n' > backend/__init__.py
RUN pip install --no-cache-dir ".[prod]"

COPY backend/ backend/
RUN pip install --no-cache-dir --no-deps .

# Go binaries on PATH
COPY --from=go-builder /out/llm-export  /usr/local/bin/llm-export
COPY --from=go-builder /out/ftdc-slice  /usr/local/bin/ftdc-slice

# K8s-native pipeline scripts (no Docker).
# The init container copies these into the data emptyDir at /data/simagix-workspace/scripts/
# so run_workspace.py finds them at DATA_ROOT/simagix-workspace/scripts/.
COPY deploy/scripts/ /app/pipeline-scripts/
RUN chmod +x /app/pipeline-scripts/*.sh

ENV PYTHONUNBUFFERED=1

# Default: run the pipeline worker
CMD ["python", "-m", "backend.app.jobs.worker"]
