# ── Python worker ───────────────────────────────────────────────────────────
# There was a go-builder stage here compiling llm-export and ftdc-slice from
# simagix-workspace/repos/mongo-ftdc. That path is gitignored, so it is absent
# from every clean checkout and the stage could never build in CI. The upstream
# repo it points at has no cmd/llm-export or cmd/ftdc-slice either.
#
# NOTE: unlike the API, the worker genuinely wants these for FTDC decode. It
# starts and polls without them, but uploads cannot be decoded — the same state
# as today, since the binaries have never been buildable here. Restore this
# stage once the fork containing cmd/llm-export is located.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Worker is Phase 1 only — `.[prod]` (no Cursor/ADK).
# Deps layer cached until pyproject.toml changes; code-only rebuilds skip heavy pip.
COPY pyproject.toml .
RUN mkdir -p backend && printf '"""pip-layer stub — replaced by COPY backend/"""\n' > backend/__init__.py
RUN pip install --no-cache-dir ".[prod]"

COPY backend/ backend/
RUN pip install --no-cache-dir --no-deps .

# K8s-native pipeline scripts (no Docker).
# The init container copies these into the data emptyDir at /data/simagix-workspace/scripts/
# so run_workspace.py finds them at DATA_ROOT/simagix-workspace/scripts/.
COPY deploy/scripts/ /app/pipeline-scripts/
RUN chmod +x /app/pipeline-scripts/*.sh

ENV PYTHONUNBUFFERED=1

# Default: run the pipeline worker
CMD ["python", "-m", "backend.app.jobs.worker"]
