# Copy to .env (gitignored) and fill in. Used by Stitch MCP via .cursor/mcp.json envFile.
# Create key: https://stitch.withgoogle.com/settings → API keys
STITCH_API_KEY=

# Cursor AI — required for the default LLM provider (cursor).
# Get your key from cursor.com/settings → API keys.
CURSOR_API_KEY=

# Default model for Phase 2 RCA. Currently set to Grok 4.5 (cursor_model in config.py).
# Other options: composer-2.5, claude-3.7-sonnet, gemini-2.5-pro, gpt-4.1, ...
# CURSOR_MODEL=grok-4.5

# Anthropic Claude — required when llm_provider=claude.
# Get your key from console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# Google Gemini — required when llm_provider=google.
# Get your key from aistudio.google.com/app/apikey.
GOOGLE_API_KEY=

# Job queue + durable store (required — see docs/PRODUCTION_ARCHITECTURE.md).
# Local dev/tests:
#   docker run -d --name mongo-debugger-pg -e POSTGRES_PASSWORD=dev \
#     -e POSTGRES_DB=mongodebugger -p 5544:5432 postgres:16-alpine
DATABASE_URL=postgresql://postgres:dev@localhost:5544/mongodebugger

# Daytona sandbox — used to execute LLM-authored matplotlib scripts safely.
# Get a free key at https://app.daytona.io → API Keys.
DAYTONA_API_KEY=
