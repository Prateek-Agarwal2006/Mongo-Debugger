# Copy to .env and fill in values for live Phase 2.
# Mock mode works without a key: force_mock=true in the RCA UI or API.

# LLM provider: cursor (default) | gemini | mock
LLM_PROVIDER=cursor

# Cursor SDK (LLM_PROVIDER=cursor)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Google ADK + AI Studio (LLM_PROVIDER=gemini) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false

# Phase 2 retrieval budgets (MCP evidence tools)
PHASE2_INVESTIGATION_MAX_TOOL_CALLS=6
PHASE2_RCA_MAX_TOOL_CALLS=6
PHASE2_MAX_CLARIFYING_QUESTIONS=10

# Post-report chatbot
PHASE2_CHATBOT_MAX_TOOL_CALLS=5
PHASE2_CHATBOT_MAX_REPLAY_MESSAGES=12
PHASE2_CHATBOT_SUMMARIZE_AFTER_MESSAGES=20

# Trusted HTTPS web fetch (RCA + chatbot)
PHASE2_WEB_FETCH_MAX_BYTES=24000
PHASE2_WEB_FETCH_TIMEOUT_S=20
# PHASE2_WEB_ALLOWLIST_SUFFIXES=mongodb.com,github.com

# Optional: Graylog log correlation (Phase A investigation)
# GRAYLOG_API_URL=
# GRAYLOG_API_TOKEN=
# GRAYLOG_AUTH_MODE=token
# GRAYLOG_DEFAULT_QUERY=source:mongod OR mongodb OR mongo
# GRAYLOG_SEARCH_LIMIT=50

# Grafana / FTDC API (defaults match local docker stack)
# GRAFANA_URL=http://localhost:3030
# FTDC_API_URL=http://localhost:5408
