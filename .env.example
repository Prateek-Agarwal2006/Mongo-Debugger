# Copy to .env and fill in values for live Phase 2 (Cursor agent).
# Mock mode works without a key: force_mock=true in the RCA UI or API.

CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Phase 2 retrieval budgets (MCP evidence tools)
PHASE2_INVESTIGATION_MAX_TOOL_CALLS=6
PHASE2_RCA_MAX_TOOL_CALLS=6
PHASE2_MAX_CLARIFYING_QUESTIONS=10

# Optional: Graylog log correlation (Phase A investigation)
# GRAYLOG_API_URL=
# GRAYLOG_API_TOKEN=
# GRAYLOG_AUTH_MODE=token
# GRAYLOG_DEFAULT_QUERY=source:mongod OR mongodb OR mongo
# GRAYLOG_SEARCH_LIMIT=50

# Grafana / FTDC API (defaults match local docker stack)
# GRAFANA_URL=http://localhost:3030
# FTDC_API_URL=http://localhost:5408
